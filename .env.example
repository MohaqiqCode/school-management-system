# ============================================
# School Management System - Environment Config
# ============================================
# Copy this file to .env and update the values
# ============================================

# Application
APP_NAME="سیستم مدیریت مدرسه"
APP_NAME_SHORT=SMS
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/school-management-system
APP_URL_SECURE=false
APP_TIMEZONE=Asia/Tehran
APP_LOCALE=fa
APP_DIRECTION=rtl
APP_VERSION=1.0.0

# Application Key (generate with: php -r "echo base64_encode(random_bytes(32));")
APP_KEY=

# Database
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=school_management_oltp
DB_USERNAME=root
DB_PASSWORD=

# Redis (Optional)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PREFIX=sms:

# Session
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_DOMAIN=null

# Email (SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@schoolmanagement.com
MAIL_FROM_NAME="سیستم مدیریت مدرسه"

# SMS Provider
SMS_PROVIDER=kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

# Payment Gateway
PAYMENT_GATEWAY=zarinpal
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# Map Service (for Transport)
NESHAN_API_KEY=
NESHAN_WEB_KEY=

# Google reCAPTCHA (Optional)
GOOGLE_RECAPTCHA_SITE_KEY=
GOOGLE_RECAPTCHA_SECRET_KEY=

# JWT Secret
JWT_SECRET=

# Monitoring Alert Email
MONITORING_ALERT_EMAIL=admin@schoolmanagement.com

# Backup
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESS=true
